          "_name": "features7",
          "_sourceTheme": "edgem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features7\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n\n        <input type=\"range\" inline name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"12\" step=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showCardText\" checked>\n        <select title=\"Advantages\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n        </select>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background2.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#232323\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#002549\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"align-center\" mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-text col-lg-{{textWidth}}\">\n                <h1 class=\"mbr-section-title align-center mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                    Performance\n                </h1>\n                <div class=\"advantages-container\">\n                    <div class=\"advantage\">\n                        <p class=\"mbr-text advantage-title align-center mbr-fonts-style mb-0\" mbr-theme-style=\"display-1\" mbr-if=\"showCardTitle\" data-app-selector=\".advantage-title\"><b>100+</b></p>\n                        <p class=\"mbr-text advantage-text align-center mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".advantage-text\">\n                            Takım arkadaşı</p>\n                    </div>\n                    <div class=\"advantage\" mbr-if=\"cardsAmount > 1\">\n                        <p class=\"mbr-text advantage-title align-center mbr-fonts-style mb-0\" mbr-theme-style=\"display-1\" mbr-if=\"showCardTitle\" data-app-selector=\".advantage-title\"><b>120+</b></p>\n                        <p class=\"mbr-text advantage-text align-center mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".advantage-text\">\n                            Toplam Proje</p>\n                    </div>\n                    <div class=\"advantage\" mbr-if=\"cardsAmount > 2\">\n                        <p class=\"mbr-text advantage-title align-center mbr-fonts-style mb-0\" mbr-theme-style=\"display-1\" mbr-if=\"showCardTitle\" data-app-selector=\".advantage-title\"><b>350+</b></p>\n                        <p class=\"mbr-text advantage-text align-center mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".advantage-text\">\n                            Mutlu müsteri</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "sREM8ElcnR",
          "_anchor": "features7-3",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@reverseContent)": {
              ".row": {
                "flex-direction": "row-reverse"
              }
            },
            ".row": {
              "align-items": "center"
            },
            ".image-wrapper": {
              "display": "flex",
              "@media (max-width: 768px)": {
                "justify-content": "center",
                "padding-bottom": "2rem",
                "order": "1"
              },
              "@media (min-width: 768px)": {
                "& when (@reverseContent)": {
                  "justify-content": "flex-start",
                  "padding-right": "2rem"
                },
                "& when not (@reverseContent)": {
                  "justify-content": "flex-end",
                  "padding-left": "2rem"
                }
              },
              "img": {
                "width": "auto",
                "max-width": "100%",
                "border-top-left-radius": "100vw",
                "border-top-right-radius": "100vw"
              }
            },
            ".col-text": {
              "@media (max-width: 768px)": {
                "padding-top": "2rem",
                "order": "2"
              },
              "@media (min-width: 768px)": {
                "& when (@reverseContent)": {
                  "padding-left": "2rem"
                },
                "& when not (@reverseContent)": {
                  "padding-right": "2rem"
                }
              }
            },
            ".text-wrapper": {
              "display": "flex",
              "flex-direction": "column",
              "align-items": "flex-start"
            },
            ".mbr-section-title": {
              "margin-bottom": "1.3rem",
              "color": "#002549"
            },
            ".mbr-text": {
              "color": "#002549",
              "width": "100%"
            },
            ".btn-container": {
              "width": "100%",
              "margin-top": "1rem"
            },
            ".mbr-section-btn": {
              "@media (max-width: 575px)": {
                "display": "flex",
                "flex-wrap": "wrap",
                "& .btn": {
                  "width": "100%"
                }
              }
            }
          },
          "_name": "features2",
          "_sourceTheme": "edgem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features2\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"4\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"4\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline name=\"imageWidth\" title=\"Image\" min=\"4\" max=\"8\" step=\"1\" value=\"6\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\" checked>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background2.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-md col-text\">\n                <div class=\"text-wrapper\">\n                    <h1 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Projenin sıfırdan tasarlanmasıyla işe başlarız</b></h1>\n                    <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">\n                        Devamında disiplinler arası yapılan yoğun toplantılar sonrasında ilgili paydaşlarla süperpoze işlemlerine geçeriz. En kritik aşama olan bu aşamada tüm bilgi ve tecrübemizi masaya koyarız. Yaşanmış acı tecrübelerin maliyetini gösteririz. Sorunları daha oluşmadan önlemek için çözüm önerilerini sunarız. Ardından alınan kararların sahada ekiplerimizce uygulanması için kritik notları online sistemlerde paylaşırız. Dikkat edilmesi gereken noktaların altını dikkatle çizeriz.&nbsp;</p>\n                    <div class=\"btn-container\">\n                        <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-info\" href=\"#bottom\" data-app-placeholder=\"Type Text\">Paylaşmaya hazırız</a></div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-md-{{imageWidth}} image-wrapper\">\n                <img src=\"@PROJECT_PATH@/assets/images/mbr-1709x1140.jpg\" alt=\"Mobirise\">\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "sREMxWnRvW",
          "_anchor": "features2-4",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            ".container": {
              "max-width": "1312px"
            },
            "img, .item-img": {
              "transition": "transform 3s, filter 0.5s",
              "overflow": "hidden",
              "& when (@autoSize)": {
                "height": "100%",
                "object-fit": "cover",
                "& when (@showCardTitle)": {
                  "height": "(@imageHeight * 112px)",
                  "object-fit": "cover"
                },
                "& when (@showCardSubtitle)": {
                  "height": "(@imageHeight * 112px)",
                  "object-fit": "cover"
                },
                "& when (@showText)": {
                  "height": "(@imageHeight * 112px)",
                  "object-fit": "cover"
                },
                "& when (@showButtons)": {
                  "height": "(@imageHeight * 112px)",
                  "object-fit": "cover"
                }
              }
            },
            ".img-filter": {
              "position": "absolute",
              "left": "0",
              "top": "0",
              "right": "0",
              "bottom": "0",
              "z-index": "-1",
              "background-color": "#7F5F5D",
              "opacity": "0",
              "transition": "0.5s all",
              "pointer-events": "none"
            },
            ".item:focus, span:focus": {
              "outline": "none"
            },
            ".item-wrapper": {
              "position": "relative"
            },
            ".slide-content": {
              "position": "relative",
              "background": "@cardsBg",
              "height": "100%",
              "display": "flex",
              "overflow": "hidden",
              "flex-flow": "column nowrap",
              "&:hover": {
                ".img-filter": {
                  "opacity": "0.6",
                  "z-index": "1"
                },
                "img": {
                  "transform": "scale3d(1.2, 1.2, 1)",
                  "filter": "saturate(0)"
                }
              },
              ".item-content": {
                "display": "grid",
                "justify-items": "start",
                "grid-auto-columns": "1fr",
                "grid-column-gap": "0px",
                "grid-row-gap": "1.25rem",
                "-ms-grid-columns": "1fr",
                "grid-template-columns": "1fr",
                "-ms-grid-rows": "auto auto",
                "grid-template-rows": "auto auto"
              },
              "& when (@showButtons)": {
                ".item-content": {
                  "padding": "1.5rem 1.5rem 0"
                },
                ".item-footer": {
                  "padding": "0 1.5rem 0.9rem"
                }
              },
              "& when not (@showButtons)": {
                ".item-content": {
                  "padding": "1.5rem"
                }
              }
            },
            ".mbr-section-btn": {
              "margin-top": "auto !important",
              "padding-top": "0.9rem !important"
            },
            ".mbr-section-head": {
              "margin-bottom": "3.25rem"
            },
            ".section-title-container": {
              "& when (@showTitleButtons)": {
                "display": "flex",
                "justify-content": "space-between",
                "align-items": "center"
              },
              ".btn": {
                "padding": "0.75rem 2.5rem"
              },
              ".btn-info-outline": {
                "&:hover": {
                  "background-color": "#f0edeb !important"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".mbr-section-subtitle": {
              "color": "#f0edeb",
              "text-align": "center"
            },
            ".mbr-text": {
              "color": "#e1965f",
              "width": "100%",
              "text-align": "center"
            },
            ".item-title-container": {
              "width": "100%"
            },
            ".item-title": {
              "color": "#002549",
              "width": "100%",
              "max-width": "100%",
              "span": {
                "background-color": "#ffffff",
                "padding-right": "1rem",
                "padding-left": "1rem",
                "border-radius": "2em",
                "line-height": "inherit",
                "font-size": "inherit"
              }
            },
            ".item-subtitle": {
              "color": "#ffffff",
              "width": "100%"
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "405px",
              "max-width": "405px",
              "@media (max-width: 768px)": {
                "min-width": "70%",
                "max-width": "initial",
                "margin-left": "1rem !important",
                "margin-right": "1rem !important"
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button-container": {
              "display": "flex",
              "flex-wrap": "nowrap",
              "width": "144px",
              "margin-left": "auto",
              "margin-right": "1rem",
              "padding-top": "3rem",
              "@media (max-width: 768px)": {
                "margin-right": "auto"
              }
            },
            ".embla__button": {
              "display": "flex",
              "width": "64px",
              "height": "64px",
              "margin-top": "-1.5rem",
              "font-size": "22px",
              "background-color": "transparent",
              "color": "@primaryColor",
              "border": "1px solid @primaryColor",
              "border-radius": "50%",
              "transition": "all 0.3s",
              "justify-content": "center",
              "align-items": "center",
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:disabled": {
                "cursor": "default",
                "display": "none"
              },
              "&.embla__button--prev": {
                "margin-right": "auto"
              },
              "&.embla__button--next": {
                "margin-left": "auto"
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%"
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".item-subtitle, .item-footer": {
              "text-align": "center",
              "color": "#001326"
            }
          },
          "_name": "slider1",
          "_sourceTheme": "edgem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider1 mbr-embla\" group=\"Sliders & Galleries\" plugins=\"embla\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\" checked>\n        <input type=\"checkbox\" name=\"showTitleButtons\" title=\"Title Button\" condition=\"showTitle\">\n        <input type=\"checkbox\" name=\"showSubtitle\" title=\"Subtitle\" checked>\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\">\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"5\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked>\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked>\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked>\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\" checked>\n        <header>Cards</header>\n        <input type=\"checkbox\" name=\"autoSize\" title=\"Auto Size\" checked>\n        <input type=\"range\" name=\"imageHeight\" title=\"Height\" min=\"1\" max=\"5\" step=\"1\" value=\"2\" condition=\"autoSize && !(showButtons==false && showCardSubtitle==false && showCardTitle==false && showText==false)\">\n        <input type=\"range\" name=\"gap\" title=\"Gap\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <input type=\"checkbox\" name=\"showCardTitle\" title=\"Label\">\n        <input type=\"checkbox\" name=\"showCardSubtitle\" title=\"Text\" checked>\n        <input type=\"checkbox\" name=\"showText\" title=\"Time\" checked>\n        <input type=\"checkbox\" name=\"showButtons\" title=\"Buttons\">\n        <input type=\"color\" name=\"cardsBg\" title=\"BG\" value=\"#ffffff\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" required>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background5.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#000000\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#fafafa\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n    <div class=\"position-relative\">\n        <div class=\"container\">\n            <div class=\"row\">\n                <div class=\"mbr-section-head\" mbr-if=\"showTitle || showSubtitle\">\n                    <div class=\"section-title-container\" mbr-if=\"showTitle\">\n                        <h4 class=\"mbr-section-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-title\"><b>Mükemmel Kadro</b></h4>\n                        <div class=\"btn-container\" mbr-if=\"showTitleButtons\">\n                            <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn\" data-toolbar=\"-mbrBtnMove\">\n                                <a class=\"btn btn-info-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">See all</a>\n                            </div>\n                        </div>\n                    </div>\n                    <h5 class=\"mbr-section-subtitle mbr-fonts-style mb-0 mt-2\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">Çalışanlar, Semta kültürü ile bütünleşmiş olduklarından ekipte uyum ve koordinasyon her zaman sağlanır.</h5>\n                </div>\n            </div>\n        </div>\n        <div class=\"embla\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\" data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\" data-align=\"center\" data-contain-scroll=\"trimSnaps\">\n            <div class=\"embla__viewport\" mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n                <div class=\"embla__container\">\n                    <div class=\"embla__slide slider-image item active\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                        <div class=\"slide-content\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"item-img\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/h7-640x640.png\" alt title>\n                                    <div class=\"img-filter\"></div>\n                                </div>\n                            </div>\n                            <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText\">\n                                <div class=\"item-title-container\" mbr-if=\"showCardTitle\">\n                                    <p class=\"item-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\"><span>Case Study</span></p>\n                                </div>\n                                <p class=\"item-subtitle mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".item-subtitle, .item-footer\" mbr-if=\"showCardSubtitle\">Ayşe Kale</p>\n                                <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">ZAYIF AKIM KOORDİNATÖR</p>\n                            </div>\n                            <div class=\"mbr-section-btn item-footer mb-0\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\"><a href class=\"btn item-btn btn-primary\" target=\"_blank\" data-app-placeholder=\"Type Text\">Read More &gt;</a></div>\n                        </div>\n                    </div>\n                    <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                        <div class=\"slide-content\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"item-img\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/harun-640x640.png\" alt title data-slide-to=\"1\" data-bs-slide-to=\"1\">\n                                    <div class=\"img-filter\"></div>\n                                </div>\n                            </div>\n                            <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText\">\n                                <div class=\"item-title-container\" mbr-if=\"showCardTitle\">\n                                    <p class=\"item-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\"><span>Case Study</span></p>\n                                </div>\n                                <p class=\"item-subtitle mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".item-subtitle, .item-footer\" mbr-if=\"showCardSubtitle\">Mehmet Eren</p>\n                                <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">DATA YÖNETİM UZMANI</p>\n                            </div>\n                            <div class=\"mbr-section-btn item-footer mb-0\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\"><a href class=\"btn item-btn btn-primary\" target=\"_blank\" data-app-placeholder=\"Type Text\">Read More &gt;</a></div>\n                        </div>\n                    </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                        <div class=\"slide-content\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"item-img\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/h6-640x640.png\" alt title data-slide-to=\"2\" data-bs-slide-to=\"2\">\n                                    <div class=\"img-filter\"></div>\n                                </div>\n                            </div>\n                            <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText\">\n                                <div class=\"item-title-container\" mbr-if=\"showCardTitle\">\n                                    <p class=\"item-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\"><span>Case Study</span></p>\n                                </div>\n                                <p class=\"item-subtitle mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".item-subtitle, .item-footer\" mbr-if=\"showCardSubtitle\">Ömer Faruk</p>\n                                <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">SERVER VE BULUT UYGULAMALARI</p>\n                            </div>\n                            <div class=\"mbr-section-btn item-footer mb-0\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\"><a href class=\"btn item-btn btn-primary\" target=\"_blank\" data-app-placeholder=\"Type Text\">Read More &gt;</a></div>\n                        </div>\n                    </div>\n                    <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                        <div class=\"slide-content\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"item-img\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/h5-640x640.png\" alt title data-slide-to=\"3\" data-bs-slide-to=\"3\">\n                                    <div class=\"img-filter\"></div>\n                                </div>\n                            </div>\n                            <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText\">\n                                <div class=\"item-title-container\" mbr-if=\"showCardTitle\">\n                                    <p class=\"item-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\"><span>Case Study</span></p>\n                                </div>\n                                <p class=\"item-subtitle mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".item-subtitle, .item-footer\" mbr-if=\"showCardSubtitle\">Nurettin Turgut</p>\n                                <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">NETWORK EXPERT</p>\n                            </div>\n                            <div class=\"mbr-section-btn item-footer mb-0\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\"><a href class=\"btn item-btn btn-primary\" target=\"_blank\" data-app-placeholder=\"Type Text\">Read More &gt;</a></div>\n                        </div>\n                    </div><div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                        <div class=\"slide-content\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"item-img\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/pexels-heitor-verdi-2169434.jpg\" alt title data-slide-to=\"4\" data-bs-slide-to=\"4\">\n                                    <div class=\"img-filter\"></div>\n                                </div>\n                            </div>\n                            <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText\">\n                                <div class=\"item-title-container\" mbr-if=\"showCardTitle\">\n                                    <p class=\"item-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\"><span>Case Study</span></p>\n                                </div>\n                                <p class=\"item-subtitle mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".item-subtitle, .item-footer\" mbr-if=\"showCardSubtitle\">Nihal Karaca&nbsp;</p>\n                                <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">FİNANS UZMANI</p>\n                            </div>\n                            <div class=\"mbr-section-btn item-footer mb-0\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\"><a href class=\"btn item-btn btn-primary\" target=\"_blank\" data-app-placeholder=\"Type Text\">Read More &gt;</a></div>\n                        </div>\n                    </div>\n                    \n                    \n                    <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                        <div class=\"slide-content\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"item-img\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/pexels-moose-photos-1036622.jpg\" alt title data-slide-to=\"5\" data-bs-slide-to=\"5\">\n                                    <div class=\"img-filter\"></div>\n                                </div>\n                            </div>\n                            <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText\">\n                                <div class=\"item-title-container\" mbr-if=\"showCardTitle\">\n                                    <p class=\"item-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\"><span>Case Study</span></p>\n                                </div>\n                                <p class=\"item-subtitle mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".item-subtitle, .item-footer\" mbr-if=\"showCardSubtitle\">Nalan Çelik</p>\n                                <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">PROJE TASARIMI</p>\n                            </div>\n                            <div class=\"mbr-section-btn item-footer mb-0\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\"><a href class=\"btn item-btn btn-primary\" target=\"_blank\" data-app-placeholder=\"Type Text\">Read More &gt;</a></div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"container\">\n                <div class=\"embla__button-container\">\n                    <button class=\"embla__button embla__button--prev\">\n                        <span class=\"mobi-mbri mobi-mbri-arrow-prev mbr-iconfont\" aria-hidden=\"true\"></span>\n                        <span class=\"sr-only visually-hidden visually-hidden\">Previous</span>\n                    </button>\n                    <button class=\"embla__button embla__button--next\">\n                        <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont\" aria-hidden=\"true\"></span>\n                        <span class=\"sr-only visually-hidden visually-hidden\">Next</span>\n                    </button>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
