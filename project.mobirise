        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            ".container": {
              "max-width": "1312px"
            },
            "img, .item-img": {
              "transition": "transform 3s, filter 0.5s",
              "overflow": "hidden",
              "height": "100%",
              "object-fit": "cover"
            },
            ".img-filter": {
              "position": "absolute",
              "left": "0",
              "top": "0",
              "right": "0",
              "bottom": "0",
              "z-index": "-1",
              "background-color": "#7F5F5D",
              "opacity": "0",
              "transition": "0.5s all",
              "pointer-events": "none"
            },
            ".item:focus, span:focus": {
              "outline": "none"
            },
            ".item-wrap": {
              "position": "relative",
              "flex-grow": "1"
            },
            ".sl-content": {
              "position": "relative",
              "background": "@cardsBg",
              "height": "100%",
              "display": "flex",
              "overflow": "hidden",
              "flex-flow": "column nowrap",
              "&:hover": {
                ".img-filter": {
                  "opacity": "0.6",
                  "z-index": "1"
                },
                "img": {
                  "transform": "scale3d(1.2, 1.2, 1)",
                  "filter": "saturate(0)"
                }
              },
              ".item-content": {
                "display": "grid",
                "justify-items": "start",
                "grid-auto-columns": "1fr",
                "grid-column-gap": "0px",
                "grid-row-gap": "1.25rem",
                "-ms-grid-columns": "1fr",
                "grid-template-columns": "1fr",
                "-ms-grid-rows": "auto auto",
                "grid-template-rows": "auto auto"
              },
              "& when (@showButtons)": {
                ".item-content": {
                  "padding": "1.5rem 1.5rem 0"
                },
                ".item-footer": {
                  "padding": "0 1.5rem 0.9rem"
                }
              },
              "& when not (@showButtons)": {
                ".item-content": {
                  "padding": "1.5rem"
                }
              }
            },
            ".mbr-section-btn": {
              "margin-top": "auto !important",
              "padding-top": "0.9rem !important"
            },
            ".mbr-section-head": {
              "margin-bottom": "4rem"
            },
            ".mbr-section-title": {
              "color": "#002549",
              "text-align": "center"
            },
            ".mbr-section-subtitle": {
              "color": "#002549",
              "text-align": "center"
            },
            ".mbr-text": {
              "color": "#ffffff",
              "width": "100%"
            },
            ".item-title-container": {
              "width": "100%"
            },
            ".item-title": {
              "color": "#000000",
              "width": "100%",
              "max-width": "100%",
              "span": {
                "background-color": "#ffffff",
                "padding-right": "1rem",
                "padding-left": "1rem",
                "border-radius": "2em",
                "line-height": "inherit",
                "font-size": "inherit"
              }
            },
            ".item-subtitle": {
              "color": "#ffffff",
              "width": "100%"
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "padding": "0 1rem",
              "@media (max-width: 767px)": {
                "max-width": "416px",
                "margin": "0 auto",
                "padding": "0 0.75rem"
              }
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%"
            },
            ".embla__container": {
              "display": "flex",
              "flex-wrap": "wrap",
              "row-gap": "2rem",
              "justify-content": "center",
              "@media (min-width: 992px)": {
                "margin": "0 -1rem"
              },
              "@media (max-width: 991px)": {
                "margin": "0 -0.75rem"
              }
            }
          },
          "_name": "gallery2",
          "_sourceTheme": "edgem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider1\" group=\"Sliders & Galleries\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\" checked>\n        <input type=\"checkbox\" name=\"showSubtitle\" title=\"Subtitle\" checked>\n        <header>Cards</header>\n        <input type=\"checkbox\" name=\"showCardTitle\" title=\"Label\" checked>\n        <input type=\"checkbox\" name=\"showCardSubtitle\" title=\"Text\" checked>\n        <input type=\"checkbox\" name=\"showText\" title=\"Time\">\n        <input type=\"checkbox\" name=\"showButtons\" title=\"Buttons\">\n        <input type=\"color\" name=\"cardsBg\" title=\"BG\" value=\"#121c3b\">\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n        </select>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" required>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background2.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#fafafa\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"mbr-section-head\" mbr-if=\"showTitle || showSubtitle\">\n                <div class=\"section-title-container\" mbr-if=\"showTitle\">\n                    <h4 class=\"mbr-section-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-title\"><b>Referanslarımızdan</b></h4>\n                </div>\n                <h5 class=\"mbr-section-subtitle mbr-fonts-style mb-0 mt-2\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">BİRKAÇI</h5>\n            </div>\n        </div>\n    </div>\n    <div class=\"embla__viewport\" mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"embla__container\">\n            <div class=\"embla__slide slider-image item col-12 col-md-6 col-lg-4\">\n                <div class=\"sl-content\">\n                    <div class=\"item-wrap\">\n                        <div class=\"item-img\">\n                            <img src=\"@PROJECT_PATH@/assets/images/regnumastrumtowers-810x512.jpg\" alt title>\n                            <div class=\"img-filter\"></div>\n                        </div>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText\">\n                        <div class=\"item-title-container\" mbr-if=\"showCardTitle\">\n                            <p class=\"item-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\"><span>SOLARKENT ve ASTRUM TOWERS</span></p>\n                        </div>\n                        <p class=\"item-subtitle mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".item-subtitle, .item-footer\" mbr-if=\"showCardSubtitle\">Konutlarda şebekeye entegre ilk güneş enerjisi sistemini devreye aldık.</p>\n                        <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">6 min read</p>\n                    </div>\n                    <div class=\"mbr-section-btn item-footer mb-0\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\"><a href class=\"btn item-btn btn-primary\" target=\"_blank\" data-app-placeholder=\"Type Text\">Read More &gt;</a></div>\n                </div>\n            </div>\n            <div class=\"embla__slide slider-image item  col-12 col-md-6 col-lg-4\" mbr-if=\"cardsAmount > 1\">\n                <div class=\"sl-content\">\n                    <div class=\"item-wrap\">\n                        <div class=\"item-img\">\n                            <img src=\"@PROJECT_PATH@/assets/images/maslak1453-686x462.png\" alt title>\n                            <div class=\"img-filter\"></div>\n                        </div>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText\">\n                        <div class=\"item-title-container\" mbr-if=\"showCardTitle\">\n                            <p class=\"item-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\"><span>MASLAK 1453</span></p>\n                        </div>\n                        <p class=\"item-subtitle mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".item-subtitle, .item-footer\" mbr-if=\"showCardSubtitle\">Türkiye'nin en prestijli projesi Maslak 1453 teslim edildi.</p>\n                        <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">7 min read</p>\n                    </div>\n                    <div class=\"mbr-section-btn item-footer mb-0\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\"><a href class=\"btn item-btn btn-primary\" target=\"_blank\" data-app-placeholder=\"Type Text\">Read More &gt;</a></div>\n                </div>\n            </div>\n            <div class=\"embla__slide slider-image item  col-12 col-md-6 col-lg-4\" mbr-if=\"cardsAmount > 2\">\n                <div class=\"sl-content\">\n                    <div class=\"item-wrap\">\n                        <div class=\"item-img\">\n                            <img src=\"@PROJECT_PATH@/assets/images/halkbankatasehir-2022-810x1215.jpg\" alt title>\n                            <div class=\"img-filter\"></div>\n                        </div>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText\">\n                        <div class=\"item-title-container\" mbr-if=\"showCardTitle\">\n                            <p class=\"item-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\"><span>HALKBANKASI</span></p>\n                        </div>\n                        <p class=\"item-subtitle mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".item-subtitle, .item-footer\" mbr-if=\"showCardSubtitle\">Finans merkezinde bulunan Halkbank Genel Müdürlüğün tüm kuvvetli ve zayıf akım elektrik işlerini tamamladık.</p>\n                        <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">5 min read</p>\n                    </div>\n                    <div class=\"mbr-section-btn item-footer mb-0\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\"><a href class=\"btn item-btn btn-primary\" target=\"_blank\" data-app-placeholder=\"Type Text\">Read More &gt;</a></div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "sREPSOZyyz",
          "_anchor": "gallery2-8",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            ".container": {
              "max-width": "1312px"
            },
            "img, .item-img": {
              "transition": "transform 3s, filter 0.5s",
              "overflow": "hidden",
              "height": "100%",
              "object-fit": "cover"
            },
            ".img-filter": {
              "position": "absolute",
              "left": "0",
              "top": "0",
              "right": "0",
              "bottom": "0",
              "z-index": "-1",
              "background-color": "#7F5F5D",
              "opacity": "0",
              "transition": "0.5s all",
              "pointer-events": "none"
            },
            ".item:focus, span:focus": {
              "outline": "none"
            },
            ".item-wrap": {
              "position": "relative",
              "flex-grow": "1"
            },
            ".sl-content": {
              "position": "relative",
              "background": "@cardsBg",
              "height": "100%",
              "display": "flex",
              "overflow": "hidden",
              "flex-flow": "column nowrap",
              "&:hover": {
                ".img-filter": {
                  "opacity": "0.6",
                  "z-index": "1"
                },
                "img": {
                  "transform": "scale3d(1.2, 1.2, 1)",
                  "filter": "saturate(0)"
                }
              },
              ".item-content": {
                "display": "grid",
                "justify-items": "start",
                "grid-auto-columns": "1fr",
                "grid-column-gap": "0px",
                "grid-row-gap": "1.25rem",
                "-ms-grid-columns": "1fr",
                "grid-template-columns": "1fr",
                "-ms-grid-rows": "auto auto",
                "grid-template-rows": "auto auto"
              },
              "& when (@showButtons)": {
                ".item-content": {
                  "padding": "1.5rem 1.5rem 0"
                },
                ".item-footer": {
                  "padding": "0 1.5rem 0.9rem"
                }
              },
              "& when not (@showButtons)": {
                ".item-content": {
                  "padding": "1.5rem"
                }
              }
            },
            ".mbr-section-btn": {
              "margin-top": "auto !important",
              "padding-top": "0.9rem !important"
            },
            ".mbr-section-head": {
              "margin-bottom": "4rem"
            },
            ".mbr-section-title": {
              "color": "#002549",
              "text-align": "center"
            },
            ".mbr-section-subtitle": {
              "color": "#002549",
              "text-align": "center"
            },
            ".mbr-text": {
              "color": "#ffffff",
              "width": "100%"
            },
            ".item-title-container": {
              "width": "100%"
            },
            ".item-title": {
              "color": "#000000",
              "width": "100%",
              "max-width": "100%",
              "span": {
                "background-color": "#ffffff",
                "padding-right": "1rem",
                "padding-left": "1rem",
                "border-radius": "2em",
                "line-height": "inherit",
                "font-size": "inherit"
              }
            },
            ".item-subtitle": {
              "color": "#ffffff",
              "width": "100%"
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "padding": "0 1rem",
              "@media (max-width: 767px)": {
                "max-width": "416px",
                "margin": "0 auto",
                "padding": "0 0.75rem"
              }
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%"
            },
            ".embla__container": {
              "display": "flex",
              "flex-wrap": "wrap",
              "row-gap": "2rem",
              "justify-content": "center",
              "@media (min-width: 992px)": {
                "margin": "0 -1rem"
              },
              "@media (max-width: 991px)": {
                "margin": "0 -0.75rem"
              }
            }
          },
          "_name": "gallery2",
          "_sourceTheme": "edgem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider1\" group=\"Sliders & Galleries\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\">\n        <input type=\"checkbox\" name=\"showSubtitle\" title=\"Subtitle\">\n        <header>Cards</header>\n        <input type=\"checkbox\" name=\"showCardTitle\" title=\"Label\" checked>\n        <input type=\"checkbox\" name=\"showCardSubtitle\" title=\"Text\" checked>\n        <input type=\"checkbox\" name=\"showText\" title=\"Time\">\n        <input type=\"checkbox\" name=\"showButtons\" title=\"Buttons\">\n        <input type=\"color\" name=\"cardsBg\" title=\"BG\" value=\"#1f2c43\">\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n        </select>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" required>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background2-1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#fafafa\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"mbr-section-head\" mbr-if=\"showTitle || showSubtitle\">\n                <div class=\"section-title-container\" mbr-if=\"showTitle\">\n                    <h4 class=\"mbr-section-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-title\"><b>Referanslarımızdan</b></h4>\n                </div>\n                <h5 class=\"mbr-section-subtitle mbr-fonts-style mb-0 mt-2\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">BAZILARI</h5>\n            </div>\n        </div>\n    </div>\n    <div class=\"embla__viewport\" mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"embla__container\">\n            <div class=\"embla__slide slider-image item col-12 col-md-6 col-lg-4\">\n                <div class=\"sl-content\">\n                    <div class=\"item-wrap\">\n                        <div class=\"item-img\">\n                            <img src=\"@PROJECT_PATH@/assets/images/emlakbank-810x456.jpg\" alt title>\n                            <div class=\"img-filter\"></div>\n                        </div>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText\">\n                        <div class=\"item-title-container\" mbr-if=\"showCardTitle\">\n                            <p class=\"item-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\"><span>EMLAK BANKASI</span></p>\n                        </div>\n                        <p class=\"item-subtitle mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".item-subtitle, .item-footer\" mbr-if=\"showCardSubtitle\">Toplam 15 bin konut. Ataköy, Ataşehir, İzmir, Ankara.&nbsp;</p>\n                        <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">6 min read</p>\n                    </div>\n                    <div class=\"mbr-section-btn item-footer mb-0\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\"><a href class=\"btn item-btn btn-primary\" target=\"_blank\" data-app-placeholder=\"Type Text\">Read More &gt;</a></div>\n                </div>\n            </div>\n            <div class=\"embla__slide slider-image item  col-12 col-md-6 col-lg-4\" mbr-if=\"cardsAmount > 1\">\n                <div class=\"sl-content\">\n                    <div class=\"item-wrap\">\n                        <div class=\"item-img\">\n                            <img src=\"@PROJECT_PATH@/assets/images/trios2023-3-810x398.jpg\" alt title>\n                            <div class=\"img-filter\"></div>\n                        </div>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText\">\n                        <div class=\"item-title-container\" mbr-if=\"showCardTitle\">\n                            <p class=\"item-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\"><span>TRIOS 2023</span></p>\n                        </div>\n                        <p class=\"item-subtitle mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".item-subtitle, .item-footer\" mbr-if=\"showCardSubtitle\">35MWA Sanayi dönüşüm projesi. Dersan Kooperatifinin büyük sanayi merkezi yatırımı.&nbsp;</p>\n                        <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">7 min read</p>\n                    </div>\n                    <div class=\"mbr-section-btn item-footer mb-0\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\"><a href class=\"btn item-btn btn-primary\" target=\"_blank\" data-app-placeholder=\"Type Text\">Read More &gt;</a></div>\n                </div>\n            </div>\n            <div class=\"embla__slide slider-image item  col-12 col-md-6 col-lg-4\" mbr-if=\"cardsAmount > 2\">\n                <div class=\"sl-content\">\n                    <div class=\"item-wrap\">\n                        <div class=\"item-img\">\n                            <img src=\"@PROJECT_PATH@/assets/images/mbr-810x1210.jpg\" alt title>\n                            <div class=\"img-filter\"></div>\n                        </div>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardSubtitle || showText\">\n                        <div class=\"item-title-container\" mbr-if=\"showCardTitle\">\n                            <p class=\"item-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\"><span>THE MARMARA OTELİ</span></p>\n                        </div>\n                        <p class=\"item-subtitle mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".item-subtitle, .item-footer\" mbr-if=\"showCardSubtitle\">Taksim ve Pera otellerinin tüm renovasyon işlemleri. Dev LED panel ve otomasyon işleri</p>\n                        <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">5 min read</p>\n                    </div>\n                    <div class=\"mbr-section-btn item-footer mb-0\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\"><a href class=\"btn item-btn btn-primary\" target=\"_blank\" data-app-placeholder=\"Type Text\">Read More &gt;</a></div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "gallery2-6",
          "_isUserblock": true,
          "_cid": "t0eqFzgENi",
