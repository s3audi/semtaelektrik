        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            ".col-text": {
              "@media (min-width: 768px)": {
                "padding-bottom": "60px",
                "padding-top": "60px"
              },
              "@media (min-width: 992px)": {
                "padding-bottom": "120px",
                "padding-top": "120px"
              }
            },
            ".container": {
              "max-width": "1312px"
            },
            ".label-text": {
              "color": "#fb9a9a",
              "position": "relative",
              "z-index": "2"
            },
            ".mbr-section-title": {
              "color": "#002549"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "color": "#ffffff"
            }
          },
          "_name": "header1",
          "_sourceTheme": "edgem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"header1\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n\n        <input type=\"range\" inline name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"12\" step=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Text\" name=\"showLabel\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/mbr-1920x1238.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#643b1c\">\n            <input type=\"video\" title=\"Video\" value=\"https://player.vimeo.com/video/688804650?autoplay=0&loop=0\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#1a1a1a\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.2\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"align-center\" mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-text col-lg-{{textWidth}}\">\n                <p class=\"mbr-text label-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showLabel\" data-app-selector=\".label-text\">- 60.yılında Semta -<br><br></p>\n                <h1 class=\"mbr-section-title mbr-fonts-style mb-0\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>1972'de İstanbul'da başladık<br><br>Havalimanları, hastaneler, üniversiteler</b><br><br><b>15 bin konuta enerji verdik<br></b><br><br><b><br></b><b><br></b></h1>\n                <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn mt-3\" mbr-if=\"showButtons\"><a class=\"btn btn-primary\" href=\"#bottom\" data-app-placeholder=\"Type Text\"><span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont mbr-iconfont-btn\"></span>Bize ulaşın</a></div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "sREJOrWGph",
          "_anchor": "header1-1",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".container": {
              "max-width": "1312px"
            },
            ".row": {
              "padding": "0 1rem",
              "@media (max-width: 991px)": {
                "padding": "0 0.75rem"
              }
            },
            ".text-container": {
              "width": "100%",
              "padding": "0"
            },
            ".mbr-section-title": {
              "margin-bottom": "4rem",
              "width": "100%",
              "color": "#ffffff"
            },
            ".cards-container": {
              "display": "grid",
              "-webkit-box-orient": "vertical",
              "-webkit-box-direction": "normal",
              "-webkit-flex-direction": "column",
              "-ms-flex-direction": "column",
              "flex-direction": "column",
              "grid-auto-columns": "1fr",
              "grid-column-gap": "8rem",
              "grid-row-gap": "4rem",
              "-ms-grid-columns": "1fr 1fr 1fr",
              "grid-template-columns": "1fr 1fr 1fr",
              "-ms-grid-rows": "auto",
              "grid-template-rows": "auto",
              "padding": "0",
              "@media (max-width: 991px)": {
                "grid-column-gap": "4rem",
                "-ms-grid-columns": "1fr 1fr",
                "grid-template-columns": "1fr 1fr"
              },
              "@media (max-width: 767px)": {
                "max-width": "20rem",
                "margin-right": "auto",
                "margin-left": "auto",
                "-ms-grid-columns": "1fr",
                "grid-template-columns": "1fr"
              }
            },
            ".card-wrapper": {
              "display": "flex",
              "flex-direction": "column",
              "align-items": "center",
              "justify-content": "flex-start",
              "flex-wrap": "wrap",
              "text-align": "center",
              "@media (max-width: 767px)": {
                "margin-left": "auto",
                "margin-right": "auto"
              }
            },
            ".card-title": {
              "color": "#003466",
              "margin-bottom": "1rem",
              "text-align": "center"
            },
            ".card-text": {
              "color": "#643b1c"
            },
            ".mbr-iconfont": {
              "font-size": "25px",
              "color": "@iconColor"
            },
            ".icon-box": {
              "width": "100%",
              "margin-bottom": "1rem",
              "display": "flex",
              "justify-content": "center"
            }
          },
          "_name": "features3",
          "_sourceTheme": "edgem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features3\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"3\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcon\" checked>\n        <input type=\"color\" title=\"Color\" name=\"iconColor\" value=\"#40b0bf\" selected condition=\"showIcon\">\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\" selected>6</option>\n        </select>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background5.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#001326\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"text-container\">\n                <h2 class=\"mbr-section-title mbr-fonts-style align-center\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Hizmetlerimiz</b></h2>\n            </div>\n            <div class=\"cards-container col-12\">\n                <div class=\"card\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"icon-box\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont icon54-v1-solar-panel\" style=\"font-size: 64px; color: rgb(0, 52, 102); fill: rgb(0, 52, 102);\"></span>\n                        </div>\n                        <div class=\"card-box\">\n                            <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\"><b>Yenilenebilir Enerji Kaynakları</b></h4>\n                            <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".card-text\">Temiz enerji kaynaklarının optimum seviyede kullanılabilmesi için çalışıyoruz. Danışmanlıktan uygulamaya verimlilik için maliyet odaklı çözüm üretiyoruz.</p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"card\" mbr-if=\"cardsAmount > 1\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"icon-box\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-contact-form mobi-mbri\" style=\"font-size: 64px; color: rgb(0, 52, 102); fill: rgb(0, 52, 102);\"></span>\n                        </div>\n                        <div class=\"card-box\">\n                            <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\"><b>Projelendirme</b></h4>\n                            <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".card-text\">35MW Türkiye'nin en büyük sanayi dönüşüm projesi Trios2023'ü tamamlamış olmaktan gurur duyuyoruz. OG, AG, Otomasyon, Kuvvetli akım, zayıf akım, topraklama projelerinin tasarımı ve maliyetlendirilmesi.</p>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"card\" mbr-if=\"cardsAmount > 2\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"icon-box\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont imind-electricity\" style=\"font-size: 70px; color: rgb(0, 67, 131); fill: rgb(0, 67, 131);\"></span>\n                        </div>\n                        <div class=\"card-box\">\n                            <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\"><b>Elektrik Panoları imalatı</b></h4>\n                            <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".card-text\">AG Panoları, Aydınlatma panoları, Dağıtım panoları, Harici Tip Panolar, Dikili tip panolar, Özel tip panolar, Sıva altı panolar, Paslanmaz panolar, Kompanzasyon panoları, yıldırımdan korunma sistemi.</p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"card\" mbr-if=\"cardsAmount > 3\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"icon-box\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-database mobi-mbri\" style=\"font-size: 64px; color: rgb(0, 52, 102); fill: rgb(0, 52, 102);\"></span>\n                        </div>\n                        <div class=\"card-box\">\n                            <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\"><b>ENDÜSTRİYEL OTOMASYON ve KONTROL SİSTEMLERİ</b></h4>\n                            <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".card-text\">Proses otomasyonu, enerji izleme ve yönetim, PLC, Scada, Data ve Network, Yangın, Seslendirme, Acil Anons, CCTV, İnterkom, TV sistemleri.</p>\n                        </div>\n                    </div>\n                </div>\n\n\n                <div class=\"card\" mbr-if=\"cardsAmount > 4\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"icon-box\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-delivery mobi-mbri\" style=\"font-size: 64px; color: rgb(0, 52, 102); fill: rgb(0, 52, 102);\"></span>\n                        </div>\n                        <div class=\"card-box\">\n                            <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\"><b>ALÇAK GERİLİM ve ORTA GERİLİM SİSTEMLERİ</b></h4>\n                            <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".card-text\">Trafo, jeneratör, dağıtım merkezleri. Dahili ve harici aydınlatma tesisatı. Busbar sistemleri, UPS.</p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"card\" mbr-if=\"cardsAmount > 5\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"icon-box\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-user mobi-mbri\" style=\"font-size: 64px; color: rgb(0, 52, 102); fill: rgb(0, 52, 102);\"></span>\n                        </div>\n                        <div class=\"card-box\">\n                            <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\"><b>Taahhüt Hizmetleri</b></h4>\n                            <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".card-text\">Kablolama, montaj, demontaj işleri. Bakım, onarım, işçilik ve devreye alma. Senkronizasyon, izleme ve raporlama. Danışmanlık.</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "sREKLYi93J",
          "_anchor": "features3-2",
