        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "overflow": "hidden",
            ".container": {
              "max-width": "800px"
            },
            ".col-text": {
              "position": "relative",
              "margin-bottom": "8rem"
            },
            ".mbr-text": {
              "color": "#002549",
              "position": "relative",
              "z-index": "2"
            },
            ".icon-box": {
              "position": "absolute",
              "bottom": "-3.2rem",
              "& when (@iconPosition = 'right')": {
                "right": "-5.5rem"
              },
              "& when (@iconPosition = 'left')": {
                "left": "-5.5rem"
              },
              "& when (@iconPosition = 'center')": {
                "left": "50%",
                "transform": "translateX(-50%)"
              },
              "@media (max-width: 1199px)": {
                "bottom": "-6.6rem",
                "& when (@iconPosition = 'right')": {
                  "right": "1.2rem"
                },
                "& when (@iconPosition = 'left')": {
                  "left": "1.2rem"
                },
                "& when (@iconPosition = 'center')": {
                  "left": "50%",
                  "transform": "translateX(-50%)"
                }
              },
              "span": {
                "color": "@iconColor"
              }
            }
          },
          "_name": "content1",
          "_sourceTheme": "edgem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"content1\" group=\"Article\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"4\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n\n        <input type=\"range\" inline name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"12\" step=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" checked>\n        <input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#E1965F\" condition=\"showIcon\">\n        <select title=\"Icon Position\" name=\"iconPosition\" condition=\"showIcon\">\n            <option value=\"left\">left</option>\n            <option value=\"center\">center</option>\n            <option value=\"right\" selected>right</option>\n        </select>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background2.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"align-center\" mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-text col-lg-{{textWidth}}\">\n                <p class=\"mbr-text mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showText\" data-app-selector=\".mbr-text\"><b>\n                    Sık Sorulan Sorular</b><br><b>SSS</b></p>\n                <div class=\"icon-box\" mbr-if=\"showIcon\">\n                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-help mobi-mbri\" style=\"font-size: 92px;\"></span>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "sRERbAjxmq",
          "_anchor": "content1-a",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@reverseContent)": {
              ".row": {
                "flex-direction": "row-reverse"
              }
            },
            ".row": {
              "@media (max-width: 991px)": {
                "max-width": "30rem",
                "margin-right": "auto",
                "margin-left": "auto"
              }
            },
            ".col-card": {
              "display": "flex",
              "@media (max-width: 991px)": {
                "padding-top": "2rem"
              },
              "@media (min-width: 992px)": {
                "& when (@reverseContent)": {
                  "padding-right": "2rem"
                },
                "& when not (@reverseContent)": {
                  "padding-left": "2rem"
                }
              }
            },
            ".col-text": {
              "@media (max-width: 991px)": {
                "padding-bottom": "2rem"
              },
              "@media (min-width: 992px)": {
                "& when (@reverseContent)": {
                  "padding-left": "2rem"
                },
                "& when not (@reverseContent)": {
                  "padding-right": "2rem"
                }
              }
            },
            ".text-wrapper": {
              "display": "flex",
              "flex-direction": "column",
              "align-items": "flex-start"
            },
            ".mbr-section-title": {
              "margin-bottom": "1.3rem",
              "color": "#002549"
            },
            ".mbr-text": {
              "color": "#002549",
              "max-width": "20rem"
            },
            ".cards-container": {
              "display": "grid",
              "-webkit-box-orient": "vertical",
              "-webkit-box-direction": "normal",
              "-webkit-flex-direction": "column",
              "-ms-flex-direction": "column",
              "flex-direction": "column",
              "grid-auto-columns": "1fr",
              "grid-column-gap": "0",
              "grid-row-gap": "1.25rem",
              "-ms-grid-columns": "1fr",
              "grid-template-columns": "1fr",
              "-ms-grid-rows": "auto",
              "grid-template-rows": "auto"
            },
            ".card-text": {
              "color": "#002549",
              "flex-grow": "1"
            },
            ".icon-box": {
              "margin-top": "0.35rem",
              "margin-right": "1rem",
              "transform": "rotateZ(-45deg)",
              "transform-style": "preserve-3d",
              "transition": "0.3s all",
              "& span": {
                "color": "@iconColor"
              }
            },
            ".card": {
              "display": "flex",
              "flex-direction": "row",
              "flex-wrap": "nowrap",
              "align-items": "flex-start",
              "justify-content": "flex-start",
              "&:hover": {
                ".icon-box": {
